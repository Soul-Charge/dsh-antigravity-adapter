{
  "name": "dsh-antigravity-adapter",
  "version": "0.2.0",
  "private": true,
  "description": "DSH plugin: Antigravity CLI (agy Headless) ExternalBackendAdapter v1 for dsh-tiered-workflow and optional standalone dispatch tool.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test/run-tests.mjs",
    "test:real": "node test/run-tests.mjs --real"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2",
    "node": ">=22.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "src",
    "docs",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Soul-Charge/dsh-antigravity-adapter.git"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  }
}
